{
  "name": "dita",
  "version": "0.3.0-bb16c46-1786258529",
  "private": true,
  "description": "Chrome extension with local Piper TTS",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "wxt build && playwright test -c e2e/playwright.config.ts --ui",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ e2e/",
    "format": "biome check --write src/ e2e/",
    "ci": "biome check src/ e2e/ && tsc --noEmit && vitest run",
    "bump:version": "node scripts/bump-version.mjs",
    "install:voices": "node scripts/install-voices.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.55.1",
    "@types/chrome": "0.2.5",
    "@types/node": "^26.1.2",
    "typescript": "5.7.3",
    "vitest": "4.1.10",
    "wxt": "0.21.3"
  },
  "dependencies": {
    "onnxruntime-web": "^1.27.0"
  }
}
