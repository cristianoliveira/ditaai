{
  "name": "ditaai",
  "version": "0.3.0-d816e5e-1787034774",
  "private": true,
  "description": "Turn web pages into private, local audio",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "wxt build && playwright test -c e2e/playwright.config.ts --ui",
    "observe": "wxt build && node scripts/observe.mjs",
    "observe:start": "scripts/observe-start.sh",
    "observe:status": "node scripts/observe-status.mjs",
    "observe:errors": "node scripts/observe-errors.mjs",
    "observe:stop": "node scripts/observe-stop.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ e2e/ scripts/",
    "format": "biome check --write src/ e2e/ scripts/",
    "ci": "biome check src/ e2e/ scripts/ && tsc --noEmit && vitest run",
    "bump:version": "node scripts/bump-version.mjs",
    "install:voices": "node scripts/install-voices.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.55.1",
    "@types/chrome": "0.2.5",
    "@types/node": "^26.1.2",
    "happy-dom": "^20.11.2",
    "typescript": "5.7.3",
    "vitest": "4.1.10",
    "wxt": "0.21.3"
  },
  "dependencies": {
    "onnxruntime-web": "^1.27.0"
  }
}
